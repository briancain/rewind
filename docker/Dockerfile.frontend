FROM node:22-slim AS builder

ARG NEXT_PUBLIC_IDENTITY_URL
ARG NEXT_PUBLIC_CATALOG_URL
ARG NEXT_PUBLIC_UPLOAD_URL
ARG NEXT_PUBLIC_STREAMING_URL
ARG NEXT_PUBLIC_SOCIAL_URL
ARG NEXT_PUBLIC_SEARCH_URL
# Link-preview (Open Graph) metadata on the watch page: the frontend's own origin for og:url and
# the content-CDN origin for the public og:image thumbnail. Inlined at build like the service URLs.
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_CDN_URL

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:22-slim

WORKDIR /app
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

ENV PORT=3000
EXPOSE 3000

CMD ["node", "server.js"]
